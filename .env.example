# =============================================================
# SAFEBASE - Environment configuration
# Optional: the project runs without a .env file, using the
# development defaults set in docker-compose.yml.
# To override a value, copy this file to .env (at the root of
# the project, next to docker-compose.yml) and edit it.
# NEVER commit the .env file.
# =============================================================

# -------------------------------------------------------------
# SECURITY
# -------------------------------------------------------------
# Secret used by the API to sign JWT tokens
# (default in docker-compose.yml: safebase_secret_key)
# Generate with: openssl rand -hex 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme_jwt_secret

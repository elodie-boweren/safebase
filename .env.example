# =============================================================
# SAFEBASE - Environment configuration
# Copy this file to .env and replace every "changeme" value.
# NEVER commit the .env file.
# =============================================================

# -------------------------------------------------------------
# 1. APPLICATION MAIN DATABASE (PostgreSQL)
#    Stores: configured connections, backup history,
#    schedules
# -------------------------------------------------------------
# Used by the app_db container (database creation)
APP_DB_NAME=safebase
APP_DB_USER=safebase_app
APP_DB_PASSWORD=changeme_app_db_password

# Used by the backend to connect
# (inside Docker: use the service name, not localhost)
APP_DB_HOST=app_db
APP_DB_PORT=5432


# -------------------------------------------------------------
# 2. SECURITY
# -------------------------------------------------------------
# Encryption key for the target databases' passwords
# stored in the main database (AES-256: 32 bytes = 64 hex characters)
# Generate with: openssl rand -hex 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if this key is lost or changed, the passwords
# already stored become unreadable.
ENCRYPTION_KEY=changeme_64_hexadecimal_characters
{
  "info": {
    "name": "SafeBase API",
    "description": "Tests de l'API SafeBase (auth + CRUD databases).\nLancer `docker compose up --build -d` avant, puis exécuter la collection dans l'ordre (Run collection).\nLe token et l'id de la base créée sont enregistrés automatiquement dans les variables de la collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "motdepasse123" },
    { "key": "token", "value": "" },
    { "key": "databaseId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Santé",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status = ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
        },
        {
          "name": "Racine",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Message API', () => pm.expect(pm.response.text()).to.include('SafeBase API is running'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/" }
        },
        {
          "name": "Connexion à Postgres",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Base connectée', () => pm.expect(pm.response.text()).to.include('Base connectée'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/test-db" }
        }
      ]
    },
    {
      "name": "2. Authentification",
      "item": [
        {
          "name": "Inscription",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Email unique à chaque exécution pour pouvoir relancer la collection",
                  "pm.collectionVariables.set('email', `test${Date.now()}@safebase.fr`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Utilisateur renvoyé', () => pm.expect(body).to.have.property('user_id'));",
                  "pm.test('Mot de passe non renvoyé', () => pm.expect(body).to.not.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testeuse\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Inscription - email déjà utilisé",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testeuse\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Connexion - mauvais mot de passe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Identifiants invalides', () => pm.expect(pm.response.json().error).to.eql('Identifiants invalides'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"mauvais\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Connexion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Token reçu', () => pm.expect(body.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Profil (me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('user_id présent', () => pm.expect(pm.response.json().user).to.have.property('user_id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Sans token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Token manquant', () => pm.expect(pm.response.json().error).to.eql('Token manquant'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/databases" }
        },
        {
          "name": "Token invalide",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}abc", "type": "string" }] },
            "url": "{{baseUrl}}/databases"
          }
        }
      ]
    },
    {
      "name": "3. Databases",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
      "item": [
        {
          "name": "Ajouter une base",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('database_id renvoyé', () => pm.expect(body).to.have.property('database_id'));",
                  "pm.test('Mot de passe non renvoyé', () => pm.expect(body).to.not.have.property('password'));",
                  "pm.collectionVariables.set('databaseId', body.database_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MySQL démo\",\n  \"description\": \"Base de test\",\n  \"type\": \"mysql\",\n  \"host\": \"mysql\",\n  \"port\": 3306,\n  \"database_name\": \"demo_mysql\",\n  \"username\": \"safebase\",\n  \"password\": \"safebasepass\"\n}"
            },
            "url": "{{baseUrl}}/databases"
          }
        },
        {
          "name": "Lister mes bases",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(d => d.database_id);",
                  "pm.test('La base créée est dans la liste', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('databaseId'))));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/databases" }
        },
        {
          "name": "Supprimer une base inexistante",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/databases/999999" }
        },
        {
          "name": "Supprimer la base",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Base supprimée', () => pm.expect(pm.response.json().message).to.eql('Base supprimée'));"
                ]
              }
            }
          ],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/databases/{{databaseId}}" }
        }
      ]
    }
  ]
}
